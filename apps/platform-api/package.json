    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@rufieltics/api-core": "workspace:^",
    "@rufieltics/auth-core": "workspace:^",
    "@rufieltics/auth-server": "workspace:^",
    "ioredis": "^5.10.0",
    "@rufieltics/db": "workspace:^",
    "@rufieltics/emails": "workspace:^",
    "cookie-parser": "^1.4.7",
    "nestjs-i18n": "^10.6.0",
    "nestjs-zod": "^5.1.1",
    "nodemailer": "^9.0.3",
