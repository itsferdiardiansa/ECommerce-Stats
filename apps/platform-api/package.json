    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
