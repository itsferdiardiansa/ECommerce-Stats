PORT=6001
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db_name>?schema=public

APP_FALLBACK_LANG=id

# Browser origin allowed for credentialed (cookie) requests. A wildcard is
# invalid when credentials are sent, so set the web app's exact origin in dev.
CORS_ORIGIN=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=rufieltics-access-secret-change-in-production
JWT_REFRESH_SECRET=rufieltics-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# Dev (Mailpit, local, free — view at http://localhost:8025):
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURE=false  (no user/pass)
# Production (Resend — https://resend.com):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=resend  SMTP_PASSWORD=<your re_... API key>
#   MAIL_FROM must be an address on a domain you've verified in Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@rufieltics.local

# Login monitoring / step-up tunables
BRUTE_FORCE_WINDOW_SECONDS=900
BRUTE_FORCE_THRESHOLD=5
IMPOSSIBLE_TRAVEL_KMH=900
KNOWN_FACTOR_TTL_SECONDS=7776000
NOTIFICATION_DEDUPE_TTL_SECONDS=86400

VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_LOCKOUT_SECONDS=3600

STEP_UP_CODE_TTL_SECONDS=300
STEP_UP_MAX_ATTEMPTS=5
STEP_UP_CHALLENGE_TTL_SECONDS=600
# Cumulative wrong factor attempts per user across all challenges before step-up
# is locked for STEP_UP_LOCKOUT_SECONDS (bounds cross-challenge brute force).
STEP_UP_MAX_USER_FAILURES=10
STEP_UP_LOCKOUT_SECONDS=900
# Two-factor (TOTP). Required in production. Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Rufieltics
TOTP_WINDOW=1
RECOVERY_CODE_COUNT=10
TOTP_ENROLMENT_TTL_SECONDS=900

# Sudo mode: how long a re-authentication covers sensitive actions
SUDO_TTL_SECONDS=300
SUDO_MAX_ATTEMPTS=5

# Geo provider for notification email location (optional). When set, ipinfo.io
# gives city/region; otherwise the offline geoip-lite DB (country-level) is used.
IPINFO_TOKEN=

# Trusted device (remember this browser) - opt-in at step-up
TRUSTED_DEVICE_TTL_SECONDS=2592000

# Passkeys (WebAuthn). Required in production.
# RP ID = the credential's domain: `localhost` in dev, the registrable parent
# (e.g. rufieltics.com) in prod. Must be the origin's domain or a parent of it,
# never the API subdomain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Rufieltics
# Exact origin(s) where the ceremony runs (the web app). Comma-separated for >1.
WEBAUTHN_ORIGIN=http://localhost:6001
WEBAUTHN_CHALLENGE_TTL_SECONDS=120
