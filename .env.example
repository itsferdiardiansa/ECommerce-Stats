POSTGRES_USER=root
POSTGRES_PASSWORD=rootpass
POSTGRES_DB=db_rufieltics_db
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin

DATABASE_URL=postgresql://root:rootpass@localhost:5432/rufieltics_db


# --- Internal / platform-api (staff admin) ---
STAFF_JWT_SECRET=change-me-staff-access-secret
STAFF_INVITE_SECRET=change-me-staff-invite-secret
STAFF_ISSUER=Rufieltics Admin
PLATFORM_WEB_URL=http://localhost:3001

# Dedicated internal Redis (docker-compose `internal-redis`, port 6380).
# If unset, platform-api falls back to the main REDIS_HOST/PORT with `staff:` prefixed keys.
STAFF_REDIS_URL=redis://localhost:6380

# Staff login lockout (failed-attempt protection)
STAFF_LOCKOUT_MAX_ATTEMPTS=5
STAFF_LOCKOUT_WINDOW=900
STAFF_LOCKOUT_DURATION=900
