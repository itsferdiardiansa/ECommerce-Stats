    }
  },
  "scripts": {
    "build": "tsc -b",
    "postinstall": "pnpm build"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "otplib": "^13.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
