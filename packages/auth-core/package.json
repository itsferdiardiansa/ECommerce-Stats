{
  "name": "@rufieltics/auth-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, principal-agnostic auth primitives (password, TOTP) for Rufieltics",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
