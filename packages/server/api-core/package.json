{
  "name": "@rufieltics/api-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared NestJS HTTP mechanics (response envelope, validation, i18n error mapping) for Rufieltics server apps",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "postinstall": "pnpm build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "nestjs-i18n": "^10.6.0",
    "nestjs-zod": "^5.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "nestjs-i18n": "^10.6.0",
    "nestjs-zod": "^5.1.1",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  }
}
