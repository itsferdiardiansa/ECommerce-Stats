  },
  "scripts": {
    "build": "tsc -b",
    "postinstall": "pnpm build"
  },
  "dependencies": {
    "@rufieltics/auth-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
