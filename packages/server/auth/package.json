{
  "name": "@rufieltics/auth-server",
  "version": "0.1.0",
  "private": true,
  "description": "Shared server-side auth logic (device binding, denylist + lockout algorithms via injected per-app stores) for Rufieltics",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
