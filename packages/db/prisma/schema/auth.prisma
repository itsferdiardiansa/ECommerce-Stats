model OAuthAccount {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("auth")
}

model Session {
  id               String    @id @default(cuid())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  jti              String    @unique
  refreshTokenHash String

  orgId            String?
  role             String?

  ipAddress        String?
  userAgent        String?

  deviceFingerprint String

  lastUsedAt       DateTime?
  isRevoked        Boolean   @default(false)
  expires          DateTime
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([jti])
  @@index([expires, isRevoked])
  @@unique([userId, deviceFingerprint])
  @@schema("auth")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("auth")
}

model UserTotp {
  id          String    @id @default(cuid())
  userId      Int       @unique
  secret      String
  confirmedAt DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("auth")
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    Int
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth")
}

// A WebAuthn credential (passkey). Phishing-resistant second factor: the private
// key never leaves the authenticator, and the browser only signs for this app's
// RP ID. counter/publicKey/credentialId are base64url. userHandle is stored so a
// later passwordless-primary phase needs no re-enrolment.
model Passkey {
  id           String    @id @default(cuid())
  userId       Int
  credentialId String    @unique
  publicKey    String
  counter      BigInt     @default(0)
  deviceType   String
  backedUp     Boolean   @default(false)
  transports   String[]
  userHandle   String
  name         String?
  aaguid       String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth")
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  // Nullable so failed attempts for a non-existent email can still be recorded
  // (needed for IP-based brute-force detection) without leaking existence.
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptedEmail    String?
  deviceFingerprint String?
  ipAddress String?
  userAgent String?
  city      String?
  country   String?
  latitude  Float?
  longitude Float?
  isSuccess Boolean  @default(true)
  reason    LoginReason?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, deviceFingerprint])
  @@index([ipAddress, createdAt])
  @@schema("auth")
}

// A browser the user has opted to trust: presenting a valid token skips the
// login step-up. Durable source of truth (Redis fronts it for the hot lookup);
// revocable and expiring. tokenHash is a SHA-256 of a random cookie token.
model TrustedDevice {
  id                String    @id @default(cuid())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  deviceFingerprint String
  label             String?
  userAgent         String?
  ipAddress         String?
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime

  @@index([userId])
  @@index([userId, deviceFingerprint])
  @@schema("auth")
}

enum LoginReason {
  SUCCESS
  INVALID_PASSWORD
  USER_NOT_FOUND
  ACCOUNT_LOCKED
  ACCOUNT_DISABLED
  EMAIL_NOT_VERIFIED
  TWO_FACTOR_REQUIRED
  TWO_FACTOR_INVALID
  RECOVERY_CODE_INVALID
  OAUTH_ERROR
  IP_RESTRICTED
  UNKNOWN_ERROR

  @@schema("auth")
}

model PasswordHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  password  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@schema("auth")
}

model VerificationLockout {
  id        Int                        @id @default(autoincrement())
  email     String
  reason    VerificationLockoutReason  @default(TOO_MANY_ATTEMPTS)
  ipAddress String?
  userAgent String?
  lockedAt  DateTime                   @default(now())
  expires   DateTime
  clearedAt DateTime?
  clearedBy Int?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([email])
  @@index([expires])
  @@index([createdAt])
  @@schema("auth")
}

enum VerificationLockoutReason {
  TOO_MANY_ATTEMPTS
  SUSPICIOUS_ACTIVITY
  MANUAL_LOCK

  @@schema("auth")
}
